<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.mapper.DormitoryMapper">

    <!-- 结果映射 -->
    <resultMap id="dormitoryResultMap" type="Dormitory">
        <id property="id" column="id"/>
        <result property="building" column="building"/>
        <result property="roomNumber" column="room_number"/>
        <result property="capacity" column="capacity"/>
        <result property="currentCount" column="current_count"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 查询所有宿舍 -->
    <select id="findAll" resultMap="dormitoryResultMap">
        SELECT * FROM dormitory ORDER BY building, room_number
    </select>

    <!-- 根据ID查询 -->
    <select id="findById" parameterType="int" resultMap="dormitoryResultMap">
        SELECT * FROM dormitory WHERE id = #{id}
    </select>

    <!-- 根据楼栋和房间号查询 -->
    <select id="findByBuildingAndRoom" resultMap="dormitoryResultMap">
        SELECT * FROM dormitory WHERE building = #{building} AND room_number = #{roomNumber}
    </select>

    <!-- 添加宿舍 -->
    <insert id="insert" parameterType="Dormitory" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO dormitory(building, room_number, capacity, current_count, status, create_time, update_time)
        VALUES(#{building}, #{roomNumber}, #{capacity}, #{currentCount}, #{status}, NOW(), NOW())
    </insert>

    <!-- 更新宿舍 -->
    <update id="update" parameterType="Dormitory">
        UPDATE dormitory
        SET building = #{building},
            room_number = #{roomNumber},
            capacity = #{capacity},
            current_count = #{currentCount},
            status = #{status},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <!-- 删除宿舍 -->
    <delete id="deleteById" parameterType="int">
        DELETE FROM dormitory WHERE id = #{id}
    </delete>

    <!-- 根据条件查询 -->
    <select id="findByCondition" parameterType="Dormitory" resultMap="dormitoryResultMap">
        SELECT * FROM dormitory
        <where>
            <if test="building != null and building != ''">
                AND building LIKE CONCAT('%', #{building}, '%')
            </if>
            <if test="roomNumber != null and roomNumber != ''">
                AND room_number LIKE CONCAT('%', #{roomNumber}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        ORDER BY building, room_number
    </select>

</mapper>

